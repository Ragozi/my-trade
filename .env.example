# =============================================================================
# My-Trade — Environment Configuration
# Copy to .env and fill in secrets. NEVER commit .env to git.
# =============================================================================

# --- Alpaca API (paper keys from https://app.alpaca.markets) ---
APCA_API_KEY_ID=your_paper_api_key
APCA_API_SECRET_KEY=your_paper_secret_key
PAPER_TRADING=true
ALLOW_LIVE_TRADING=false

# =============================================================================
# Asset class — Phase 4 (Claude research) requires equities
# =============================================================================
ASSET_CLASS=equities
CRYPTO_MODE=false
# Seed watchlist for weekly swing research (merged with actives when screener on)
EQUITY_SYMBOLS=SOFI,PLTR,HOOD,RIVN,PATH,MARA,OPEN,NIO,UBER,SHOP

# --- Runtime ---
SCAN_INTERVAL_SECONDS=120
VERBOSE_DEBUG=false
LOG_EVERY_N_SCANS=5
SLACK_NOTIFY_SCANS=false
ENTRY_TIMEFRAME=5Min
TREND_TIMEFRAME=15Min
TREND_TIMEFRAME_15M=1Hour
BAR_LIMIT=200

# --- Strategy: weekly swing (YouTube-style research + deterministic pullback) ---
# Goal: multi-day / ~weekly wins compounding toward monthly income.
# NOT AM gap flips or 24h lottery tickets.
GAP_SCALP_MODE=false
OPENING_SCALP_ENABLED=false
OPENING_SCALP_RESEARCH_OPTIONAL=false
REQUIRE_5M_UPTREND=true
REQUIRE_15M_UPTREND=false
REQUIRE_VOLUME_SPIKE=false
REQUIRE_ABOVE_EMA9=false
REQUIRE_RSI_TURNING_UP=true
REQUIRE_MACD_POSITIVE=true
REQUIRE_MACD_EXPANDING=false
# Swing pullbacks, not deep oversold scalps — BB lower-half off so mid-band reclaims can enter
BOLLINGER_LOWER_HALF_ONLY=false
MOMENTUM_ABOVE_VWAP=false
RSI_OVERSOLD=52
RSI_OVERBOUGHT=70
VWAP_PULLBACK_PCT=0.02
STOP_LOSS_PCT=0.03
TAKE_PROFIT_DOLLARS=0
TAKE_PROFIT_PCT=0.08
# ~5 calendar days wall-clock soft time stop (brackets still protect)
MAX_HOLD_MINUTES=7200

# --- Risk — monthly income via weekly swings on $15k virtual ---
MAX_RISK_PER_TRADE_PCT=0.02
MAX_TOTAL_OPEN_RISK_PCT=0.06
DAILY_LOSS_LIMIT_PCT=0.02
DAILY_PROFIT_TARGET_PCT=0.03
MAX_DRAWDOWN_PCT=0.15
MAX_OPEN_POSITIONS=2
MAX_ENTRIES_PER_SYMBOL_PER_DAY=1
MAX_DAILY_ENTRIES=2
TRADING_CAPITAL=15000
MAX_NOTIONAL_PCT=0.40

# --- Screener: liquid names + actives (not overnight gap lottery) ---
USE_SCREENER=true
SCREENER_MOVERS_ONLY=false
SCREENER_USE_MOVERS=true
SCREENER_MOVERS_SOURCE=actives
SCREENER_MOVERS_TOP=30
SCREENER_MOVERS_MIN_VOLUME=500000
SCREENER_MERGE_SEED_WITH_MOVERS=true
SCREENER_SEED_SYMBOLS=SOFI,PLTR,HOOD,RIVN,PATH,MARA,OPEN,NIO,UBER,SHOP
SCREENER_FALLBACK_TO_STATIC=true
SCREENER_EXCLUDE_LEVERAGED_ETFS=true
SCREENER_EXCLUDE_LARGE_CAPS=false
SCREENER_TOP_N=8
SCREENER_REFRESH_SECONDS=600
SCREENER_AM_REFRESH_SECONDS=300
SCREENER_TIMEFRAME=15Min
SCREENER_MIN_BARS=20
SCREENER_ATR_PERIOD=14
SCREENER_LOOKBACK=20
SCREENER_BAR_LIMIT=80
SCREENER_MIN_PRICE=5
SCREENER_MAX_PRICE=150
SCREENER_MIN_DOLLAR_VOLUME=200000
SCREENER_MIN_ATR_PCT=0.005
SCREENER_MIN_CHANGE_PCT=0.0
SCREENER_MIN_GAP_PCT=0.0
SCREENER_REQUIRE_PREMARKET_UP=false
SCREENER_WEIGHT_VOLATILITY=1.0
SCREENER_WEIGHT_LIQUIDITY=1.2
SCREENER_WEIGHT_MOMENTUM=0.5
SCREENER_WEIGHT_GAP=0.0

# =============================================================================
# Phase 4 / 4.5 — Multi-provider research (ADVISORY ONLY)
# =============================================================================
ENABLE_RESEARCH=true
RESEARCH_TIER_MODE=both

RESEARCH_WORKHORSE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RESEARCH_WORKHORSE_INTERVAL_SECONDS=600
RESEARCH_WORKHORSE_MAX_CALLS_PER_DAY=20
RESEARCH_WORKHORSE_MAX_TOKENS=2048

RESEARCH_PREMIUM_PROVIDER=xai
RESEARCH_PREMIUM_XAI_MODEL=grok-4.3
RESEARCH_PREMIUM_OPENAI_MODEL=gpt-4o
RESEARCH_PREMIUM_INTERVAL_SECONDS=1800
RESEARCH_PREMIUM_MAX_CALLS_PER_DAY=6
RESEARCH_PREMIUM_MAX_TOKENS=2048

XAI_API_KEY=
XAI_MODEL=grok-4.3

ENABLE_CLAUDE=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# YouTube-style: deterministic core enters; research VETOES bad names (not co-sign every long)
CLAUDE_REQUIRE_APPROVAL=false
CLAUDE_MIN_CONFIDENCE=0.55
CLAUDE_MARKET_HOURS_ONLY=true
RESEARCH_BLOCK_AVOID=true
RESEARCH_BLOCK_HOLD=false
# Only strong avoids stick when a research call is skipped (weak 0.1–0.3 noise ignored)
RESEARCH_ENTRY_VETO_MIN_CONFIDENCE=0.55
